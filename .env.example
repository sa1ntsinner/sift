# sift reads settings from `sift config` (config.toml + system keychain). Environment variables override them —
# handy for Docker (`docker compose` reads this file as .env), GitHub Actions and one-off runs.

# --- Steam (required) ---
STEAM_ID64=                # your SteamID64 (sift config set steam <link> shows it)
STEAM_API_KEY=             # https://steamcommunity.com/dev/apikey
STEAM_COUNTRY=US           # store country of your Steam account: TR, KZ, RU, DE, US …

# --- optional ---
ITAD_API_KEY=              # https://isthereanydeal.com/apps/my/  (price history verdicts)
STEAM_BALANCE=             # max price in your store's currency
SIFT_FAMILY=               # comma-separated SteamID64s of Steam Family members (no local Steam client)
SIFT_LANG=en               # en | ru
# SIFT_PROFILE=main        # settings profile
# SIFT_HOME=/data          # keep config, database and keyring namespace in one folder

# --- notifications (pick at least one) ---
SIFT_TELEGRAM_TOKEN=       # from @BotFather
SIFT_TELEGRAM_CHAT=        # `sift notify setup telegram` finds it
# SIFT_DISCORD_WEBHOOK=
# SIFT_NTFY_TOPIC=
# SIFT_NOTIFY_MODE=digest  # digest | instant
